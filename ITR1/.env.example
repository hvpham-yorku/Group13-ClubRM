# Copy this file to `.env` (never commit the real one) and fill in values.

# ── Client-side (exposed to the browser via Vite; VITE_ prefix required) ──
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
VITE_GOOGLE_REDIRECT_URI=http://localhost:5173

# ── Server-only (used by Vercel serverless functions, e.g. /api/brief) ──
# Do NOT prefix with VITE_ — that would bundle the key into the client.
GEMINI_API_KEY=your-gemini-api-key
